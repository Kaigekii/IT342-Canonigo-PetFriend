<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_app_motif">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sitter Profile"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/gray_dark"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_light"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvSitterProfileHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pet Sitter"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gray_dark" />

            <TextView
                android:id="@+id/tvSitterProfileStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending Verification"
                android:textSize="12sp"
                android:textColor="@color/gray_text"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bio"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etSitterBio"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/bg_input_cream"
                android:padding="12dp"
                android:hint="Tell owners about you"
                android:textSize="13sp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Experience"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etSitterExperience"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="e.g. 2 years"
                android:textSize="13sp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etSitterLocation"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="City / Area"
                android:textSize="13sp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hourly Rate (PHP)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etSitterRate"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:textSize="13sp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Services Offered"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:layout_marginTop="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnServiceWalk"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="Walk"
                    android:textStyle="bold"
                    android:textColor="@color/gray_dark"
                    android:backgroundTint="@color/soft_peach"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnServiceFeeding"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="Feeding"
                    android:textStyle="bold"
                    android:textColor="@color/gray_dark"
                    android:backgroundTint="@color/soft_peach"
                    android:textSize="12sp"
                    android:layout_marginStart="6dp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnServiceOvernight"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="Overnight"
                    android:textStyle="bold"
                    android:textColor="@color/gray_dark"
                    android:backgroundTint="@color/soft_peach"
                    android:textSize="12sp"
                    android:layout_marginStart="6dp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnServicePlaytime"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="Playtime"
                    android:textStyle="bold"
                    android:textColor="@color/gray_dark"
                    android:backgroundTint="@color/soft_peach"
                    android:textSize="12sp"
                    android:layout_marginStart="6dp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Availability"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:layout_marginTop="16dp" />

            <include layout="@layout/item_availability_row" />
            <include layout="@layout/item_availability_row_tue" />
            <include layout="@layout/item_availability_row_wed" />
            <include layout="@layout/item_availability_row_thu" />
            <include layout="@layout/item_availability_row_fri" />
            <include layout="@layout/item_availability_row_sat" />
            <include layout="@layout/item_availability_row_sun" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student ID"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etSitterStudentId"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="Optional"
                android:textSize="13sp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reference Contact"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etSitterReference"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="Phone or email"
                android:textSize="13sp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verification Document URL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/gray_text"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etSitterVerification"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="https://..."
                android:textSize="13sp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSitterProfile"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Save"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/web_surface"
                    android:backgroundTint="@color/gray_dark"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitVerification"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Send Verification"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/gray_dark"
                    android:backgroundTint="@color/soft_peach"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSitterLogout"
                android:layout_width="140dp"
                android:layout_height="44dp"
                android:text="Logout"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/web_surface"
                android:backgroundTint="@color/error_red"
                android:layout_marginTop="16dp"
                android:layout_gravity="end"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
