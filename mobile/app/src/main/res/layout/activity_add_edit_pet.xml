<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_app_motif">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvPetFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Pet"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/gray_dark"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_light"
            android:padding="16dp">

            <EditText
                android:id="@+id/etPetName"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Pet name"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/spPetSpecies"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_cream"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etPetBreed"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Breed"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etPetAge"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Age"
                android:inputType="number"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etPetWeight"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Weight (kg)"
                android:inputType="numberDecimal"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/spPetVaccination"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_cream"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etPetSpecialNeeds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:hint="Special needs"
                android:background="@drawable/bg_input_cream"
                android:padding="12dp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etPetPhotoUrl"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Photo URL"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePet"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Save"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"
                android:background="@drawable/bg_button_peach" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelPet"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Cancel"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"
                android:backgroundTint="@color/gray_border"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
