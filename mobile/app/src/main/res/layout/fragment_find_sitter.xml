<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_app_motif">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find Sitters"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/gray_dark"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_light"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etSitterLocation"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Location"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/spSitterService"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_cream"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSitterSearch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Search"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"
                android:background="@drawable/bg_button_peach" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSitters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
