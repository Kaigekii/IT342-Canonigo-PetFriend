<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_app_motif">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Sitter"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/gray_dark"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvBookingSitterName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sitter Name"
            android:textSize="14sp"
            android:textColor="@color/gray_text"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_light"
            android:padding="16dp">

            <Spinner
                android:id="@+id/spBookingService"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_cream"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etBookingDate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:focusable="false"
                android:hint="Date"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etBookingStart"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:focusable="false"
                android:hint="Start time"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etBookingEnd"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:focusable="false"
                android:hint="End time"
                android:background="@drawable/bg_input_cream"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select pets"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/petCheckboxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etBookingNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:hint="Special instructions"
                android:background="@drawable/bg_input_cream"
                android:padding="12dp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray_light"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitBooking"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Submit Booking"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"
                android:background="@drawable/bg_button_peach" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
